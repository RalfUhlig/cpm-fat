{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format.
    // All tasks run the Makefile (see BUILD.md). The problem matchers turn
    // Pasmo's error and warning messages into clickable entries.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make",
            "detail": "Build everything into build/",
            "type": "shell",
            "command": "make",
            "problemMatcher": [
                {
                    "owner": "pasmo",
                    "severity": "error",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}"
                    ],
                    "pattern": [
                        {
                            "regexp": "^ERROR on line (\\d+) of file (.+)$",
                            "line": 1,
                            "file": 2
                        },
                        {
                            "regexp": "^ERROR: (.*)$",
                            "message": 1
                        }
                    ]
                },
                {
                    "owner": "pasmo",
                    "severity": "warning",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}"
                    ],
                    "pattern": {
                        "regexp": "^WARNING: (.*) on line (\\d+) of file (.+)$",
                        "message": 1,
                        "line": 2,
                        "file": 3
                    }
                }
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "make utils",
            "detail": "Build only the CP/M programs in utils/",
            "type": "shell",
            "command": "make utils",
            "problemMatcher": [
                {
                    "owner": "pasmo",
                    "severity": "error",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}"
                    ],
                    "pattern": [
                        {
                            "regexp": "^ERROR on line (\\d+) of file (.+)$",
                            "line": 1,
                            "file": 2
                        },
                        {
                            "regexp": "^ERROR: (.*)$",
                            "message": 1
                        }
                    ]
                },
                {
                    "owner": "pasmo",
                    "severity": "warning",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}"
                    ],
                    "pattern": {
                        "regexp": "^WARNING: (.*) on line (\\d+) of file (.+)$",
                        "message": 1,
                        "line": 2,
                        "file": 3
                    }
                }
            ],
            "group": "build"
        },
        {
            "label": "make eeprom",
            "detail": "Build cpm.hex and write it to the EEPROM with minipro",
            "type": "shell",
            "command": "make eeprom",
            "problemMatcher": [
                {
                    "owner": "pasmo",
                    "severity": "error",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}"
                    ],
                    "pattern": [
                        {
                            "regexp": "^ERROR on line (\\d+) of file (.+)$",
                            "line": 1,
                            "file": 2
                        },
                        {
                            "regexp": "^ERROR: (.*)$",
                            "message": 1
                        }
                    ]
                },
                {
                    "owner": "pasmo",
                    "severity": "warning",
                    "fileLocation": [
                        "relative",
                        "${workspaceFolder}"
                    ],
                    "pattern": {
                        "regexp": "^WARNING: (.*) on line (\\d+) of file (.+)$",
                        "message": 1,
                        "line": 2,
                        "file": 3
                    }
                }
            ],
            "group": "build"
        },
        {
            "label": "make clean",
            "detail": "Remove build/",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        }
    ]
}
